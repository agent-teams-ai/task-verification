{
  "name": "@agent-teams/task-verification-m2-a",
  "version": "0.1.0",
  "private": true,
  "description": "M2-A model-free experimental substrate: foundation, fixture and behavioral oracle for Task Verification (WP0-WP2). No live model calls.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.13.1",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.ts",
    "test:next-family": "node --test --test-concurrency=1 --test-timeout=180000 synthetic/next-family/tests/proxy-path.test.mjs synthetic/next-family/tests/serialize.test.mjs synthetic/next-family/tests/proxy-limits.test.mjs synthetic/next-family/tests/budget.test.mjs synthetic/next-family/tests/attempt.test.mjs synthetic/next-family/tests/fixture.test.mjs",
    "check:next-family": "node synthetic/next-family/checks/verify-gates.mjs"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "7.0.2"
  }
}
