diff --git a/README.md b/README.md
index c1514fe..d6d337b 100644
--- a/README.md
+++ b/README.md
@@ -8,10 +8,14 @@ A small TypeScript service over an in-memory record store.
 | ------ | --------- | -------------------------------------------------------- |
 | GET    | `/health` | Liveness probe.                                          |
 | GET    | `/records` | Lists records. Query: `status`, `nameContains`, `limit`, `offset`. |
+| GET    | `/records.csv` | Exports the filtered records as CSV. Query: `status`, `nameContains`. |
 
 `/records` returns `{ items, total, limit, offset }`. `total` is the size of the filtered set
 before pagination; `limit` defaults to 20 and may not exceed 100; `offset` defaults to 0.
 
+`/records.csv` returns `text/csv` with the header `id,name,status,createdAt` and one row per record
+matching the same filters as `/records`, over the whole filtered set.
+
 ## Shared helpers
 
 - `src/format.ts` — `toUtcIsoString`, the single timestamp formatter used by the service.
diff --git a/src/records.ts b/src/records.ts
index 965ffcd..2a9c446 100644
--- a/src/records.ts
+++ b/src/records.ts
@@ -1,3 +1,4 @@
+import { escapeCsvField, toCsvRow } from "./csv.ts";
 import { toUtcIsoString } from "./format.ts";
 import { allRecords, type RecordRow, type RecordStatus } from "./store.ts";
 
@@ -105,3 +106,25 @@ export function listRecords(query: ListQuery): ListResult {
     offset: query.offset,
   };
 }
+
+/** Column order of the CSV export; also its header row. */
+export const CSV_COLUMNS = ["id", "name", "status", "createdAt"] as const;
+
+/**
+ * Exports the records matching the requested filters as a CSV document.
+ *
+ * The export applies the same filter set as the listing (`status`,
+ * `nameContains`) over the whole filtered set, not one listing page. Every row
+ * is built with the shared escaping helper and every timestamp with the shared
+ * UTC formatter, so no quoting or offset logic is reimplemented here.
+ */
+export function exportRecordsCsv(query: ListQuery): string {
+  const filtered = allRecords().filter((record) => matches(record, query));
+  const rows: string[] = [toCsvRow(CSV_COLUMNS)];
+  for (const record of filtered) {
+    rows.push(
+      toCsvRow([record.id, record.name, record.status, toUtcIsoString(record.createdAt)]),
+    );
+  }
+  return `${rows.join("\n")}\n`;
+}
